      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Das Modell gibt eine ZAHL in eine\nmaschinell gebaute Liste zurück.\nKein Pfad. Ein Satz im Transkript\nkann keinen Schreibort wählen.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Das Modell gibt eine ZAHL in eine\nmaschinell gebaute Liste zurück.\nKein Pfad. Ein Satz im Transkript\nkann keinen Schreibort wählen.",
      "autoResize": true,
      "lineHeight": 1.25
    },
