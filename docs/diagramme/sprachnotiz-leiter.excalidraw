      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Es nennt den Satz wörtlich, der zur\nWahl führte. Das Programm prüft, ob\ner dort steht. Kein Beleg, keine\nVerknüpfung — zeigen statt assoziieren.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
