# Zugang der POSTFACH-App fuer den Mail-Eingang (Schwesterstrecke,
# notiz_abholer.py). Nur noetig, wenn diese Strecke mitlaeuft.
#
# Kopieren nach $SECRETS_DIR/postfach.env, Rechte 0640.

NOTIZEN_TENANT_ID=00000000-0000-0000-0000-000000000000
NOTIZEN_CLIENT_ID=00000000-0000-0000-0000-000000000000
NOTIZEN_CLIENT_SECRET=<der WERT des Client-Secrets>

NOTIZEN_POSTFACH=notizen@example.com

# Allowlist der erlaubten Absenderadressen, kommagetrennt.
# LEER HEISST: kein Gate, kein Lauf — das Programm bricht ab. Das ist Absicht:
# ein Postfach, an das jeder schreiben darf, schreibt jeder ins Vault.
NOTIZEN_ABSENDER=eigner@example.com,zweitgeraet@example.com

# Rotation: <Datum eintragen>.
