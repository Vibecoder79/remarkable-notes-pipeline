# Zugang der POSTFACH-App fuer das Tablet (Mail.ReadWrite, Mail.Send).
#
# Getrennt von m365.env, und zwar nicht aus Ordnungsliebe: Diese App darf senden.
# Ohne Application Access Policy koennte dieser Schluessel als JEDE Person im
# Mandanten senden. Siehe docs/entscheidungen/E-09.
#
# Kopieren nach $SECRETS_DIR/remarkable.env, Rechte 0640, Eigentuemer das
# Dienstkonto. NIE ins Repo. Wird zeilenweise gelesen, nie per `source`.

REMARKABLE_TENANT_ID=00000000-0000-0000-0000-000000000000
REMARKABLE_CLIENT_ID=00000000-0000-0000-0000-000000000000
REMARKABLE_CLIENT_SECRET=<der WERT des Client-Secrets, nicht die Secret-ID>

# Das Dienstpostfach, das abgefragt wird. Muss das einzige Mitglied der
# Sicherheitsgruppe sein, auf die die Access Policy zeigt.
REMARKABLE_POSTFACH=tablet@example.com

# Rotation: <Datum eintragen>. Es gibt keine Erinnerung, die von selbst kommt.
