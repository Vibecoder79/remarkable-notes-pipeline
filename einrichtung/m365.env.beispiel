# Zugang der BIBLIOTHEKS-App (Sites.Selected).
#
# Kopieren nach $SECRETS_DIR/m365.env, Rechte 0640, Eigentuemer das Dienstkonto.
# NIE ins Repo. Die Datei wird zeilenweise gelesen, nie per `source` —
# sie ist eine Wertetabelle, kein Programm.

M365_TENANT_ID=00000000-0000-0000-0000-000000000000
M365_CLIENT_ID=00000000-0000-0000-0000-000000000000
M365_CLIENT_SECRET=<der WERT des Client-Secrets, nicht die Secret-ID>

# Kennung der SharePoint-Site, auf der die Bibliotheken liegen.
# Form: contoso.sharepoint.com,<site-guid>,<web-guid>
# Zu finden ueber:  GET /sites/contoso.sharepoint.com:/sites/<name>
M365_SITE_ID=contoso.sharepoint.com,00000000-...,00000000-...

# Rotation: <Datum eintragen>. Es gibt keine Erinnerung, die von selbst kommt.

# Empfaenger der Sammelmeldung aus dem Sprachnotiz-Zweig.
# Nur noetig, wenn dieser Zweig laeuft.
M365_POSTFACH=eigner@example.com
